{
    "name": "express-node-typescript-starter",
    "version": "1.0.0",
    "description": "Express.js + TypeScript starter with a production-ready project structure, middleware, logging, validation, and error handling.",
    "keywords": [
        "typescript",
        "starter"
    ],
    "homepage": "https://github.com/dev-devendra21/express-typescript-starter#readme",
    "bugs": {
        "url": "https://github.com/dev-devendra21/express-typescript-starter/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dev-devendra21/express-typescript-starter.git"
    },
    "license": "ISC",
    "author": "devendra",
    "type": "module",
    "main": "dist/server.js",
    "scripts": {
        "test": "echo \"Error: no test specified\" && exit 1",
        "dev": "tsx watch src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "format:fix": "prettier . --write",
        "format:check": "prettier . --check",
        "lint:fix": "eslint . --fix",
        "lint:check": "eslint .",
        "prepare": "husky"
    },
    "dependencies": {
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dotenv": "^18.0.2",
        "express": "^5.2.1",
        "helmet": "^8.3.0",
        "http-errors": "^2.0.1",
        "http-status": "^2.1.0",
        "mongoose": "^9.10.3",
        "morgan": "^1.12.1",
        "uuid": "^14.0.2",
        "winston": "^3.19.0",
        "winston-daily-rotate-file": "^5.0.0",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/morgan": "^1.9.10",
        "@types/node": "^26.6.2",
        "eslint": "^10.11.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.5.1",
        "prettier": "3.9.8",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.70.1"
    },
    "lint-staged": {
        "*.ts": [
            "npm run format:fix",
            "npm run lint:fix"
        ]
    }
}
